.venv/
__pycache__/
*.pyc
.uv/
dist/
build/
*.egg-info/
.DS_Store
.context/

# Deployment secrets and state. .env.example and tokens.map.example are
# committed; the real ones never are.
.env
deploy/nginx/secrets/*.map
deploy/letsencrypt/
# An organisation's vocabulary can be confidential. The directory itself
# is tracked so the compose mount never has to create it.
deploy/glossary/*
!deploy/glossary/.gitkeep
