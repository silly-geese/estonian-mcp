# Copy to .env and fill in. .env is gitignored; this file is not.

# Public hostname. Must already resolve to this host over IPv4 (and AAAA
# if you have one) before ./deploy/init-letsencrypt.sh will work - the
# ACME HTTP-01 challenge is Let's Encrypt connecting back to port 80.
DOMAIN=mcp.example.ee

# Expiry and problem notices from Let's Encrypt go here.
LETSENCRYPT_EMAIL=you@example.ee

# Guards the nginx -> app hop only. Not a client credential: clients get
# their own tokens via ./deploy/new-token.sh. Must be at least 16
# characters (server.py rejects shorter ones in bearer mode).
#
#   openssl rand -base64 32
INTERNAL_TOKEN=

# Host-side ports. The defaults are what a public deployment needs.
# Change them for local testing, where 80 and 443 are usually already
# taken. nginx still listens on 80 and 443 inside the container.
#
# Let's Encrypt always connects to the public port 80 to validate, so a
# real certificate needs HTTP_PORT=80. On other ports use
# ./deploy/local-cert.sh and a self-signed certificate instead.
HTTP_PORT=80
HTTPS_PORT=443

# 1 while you are still getting DNS and firewall right. Let's Encrypt
# allows only 5 failed validations per account per hostname per hour on
# the production endpoint, and staging certificates are untrusted but
# unlimited. Set to 0 and re-run init-letsencrypt.sh for a real one.
STAGING=1
