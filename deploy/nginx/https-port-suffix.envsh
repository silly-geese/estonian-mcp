#!/bin/sh
# Turn HTTPS_PORT into the suffix the HTTP->HTTPS redirect needs.
#
# nginx has no conditional expression that can collapse the default
# port to an empty string, and envsubst only substitutes, it does not
# compute. So the decision is made here instead.
#
#   HTTPS_PORT=443   -> ""       https://host/path
#   HTTPS_PORT=8443  -> ":8443"  https://host:8443/path
#
# The official entrypoint SOURCES files named *.envsh, so an export
# here is visible to the 20-envsubst step that runs next. The 19-
# prefix is what puts this before that step.

if [ "${HTTPS_PORT:-443}" = "443" ]; then
    HTTPS_PORT_SUFFIX=""
else
    HTTPS_PORT_SUFFIX=":${HTTPS_PORT}"
fi

export HTTPS_PORT_SUFFIX
