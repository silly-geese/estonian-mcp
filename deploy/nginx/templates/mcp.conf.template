# Rendered to /etc/nginx/conf.d/mcp.conf at container start by the
# official image's envsubst step.
#
# ONLY ${DOMAIN}, ${INTERNAL_TOKEN}, ${HTTPS_PORT_SUFFIX} and
# ${OAUTH_CODE} are substituted - see NGINX_ENVSUBST_FILTER in
# docker-compose.yaml. Every other $name below is an nginx runtime
# variable and must reach nginx verbatim. If you add a new build-time
# placeholder, add it to that filter too, or it will arrive as an empty
# string.

# ---------------------------------------------------------------------
# Bearer auth
# ---------------------------------------------------------------------
# 1. Pull the credential out of the Authorization header. The scheme is
#    matched case-insensitively per RFC 6750; the credential itself is
#    not.
map $http_authorization $bearer_token {
    default                       "";
    "~*^Bearer\s+(?<tok>\S+)$"    $tok;
}

# 2. Credential -> client id. Anything not listed falls to the default
#    of "", which the /mcp location rejects with a 401. Revoking a
#    client is deleting its line and reloading; there is no state
#    anywhere else.
#
#    The wildcard is deliberate. A missing file in a non-wildcard
#    include is a fatal config error, and nginx failing to start also
#    takes down the ACME challenge on port 80, so a missing token map
#    would eventually cost you the certificate too. Matching nothing
#    instead leaves every request unauthenticated, which is a 401 for
#    everyone rather than an outage. It also lets you split clients
#    across several tokens-*.map files.
map $bearer_token $mcp_client {
    default   "";
    include   /etc/nginx/secrets/tokens*.map;
}

# 3. OAuth client id -> the access token issued to that client.
#
#    Keyed on a header rather than on $remote_user directly, because the
#    lookup happens in the loopback responder at the bottom of this
#    file, which is a separate request. auth_basic on /oauth/token puts
#    the authenticated client id in $remote_user and it is forwarded
#    from there.
#
#    Each client has its own token here, which is what keeps an OAuth
#    client an ordinary client everywhere downstream: its own name in
#    the access log, its own rate-limit bucket, and revocation that does
#    not disturb anyone else.
map $http_x_oauth_client $oauth_access_token {
    default   "";
    include   /etc/nginx/secrets/oauth_tokens*.map;
}

# ---------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------
# per_client is the real quota and is keyed on the identity resolved
# above. per_ip is a coarse ceiling that also covers unauthenticated
# traffic, which never gets far enough to have a client id.
#
# Ordering note: limit_req runs in the preaccess phase, after the
# rewrite phase where the 401 below is returned. Rejected requests
# therefore do not consume per_client budget, which is why the per_ip
# zone exists to absorb credential-stuffing attempts.
# ---------------------------------------------------------------------
# OAuth redirect allowlist
# ---------------------------------------------------------------------
# nginx has no way to percent-decode $arg_redirect_uri, and the raw
# encoded value cannot go into a Location header. So the decoded target
# is rebuilt from a regex capture instead. That constraint is not a loss:
# OAuth requires a redirect_uri allowlist anyway, and this is one.
#
# Anything not matched yields "" and /oauth/authorize answers 400. If a
# client uses a different callback, read the rejected value out of the
# access log and add a line here.
map $arg_redirect_uri $oauth_redirect {
    default "";
    "~*^https%3A%2F%2F(?<cb>claude\.(?:ai|com))%2Fapi%2Fmcp%2Fauth_callback$"
        "https://$cb/api/mcp/auth_callback";
    # Local testing with a stub client.
    "~*^http%3A%2F%2F(?<lh>localhost(?::[0-9]+)?)%2Fcallback$"
        "http://$lh/callback";
}

limit_req_zone  $mcp_client         zone=per_client:10m rate=120r/m;
limit_req_zone  $binary_remote_addr zone=per_ip:10m     rate=300r/m;
limit_conn_zone $mcp_client         zone=conn_client:10m;

limit_req_status  429;
limit_conn_status 429;

# No $http_authorization and no $query_string: the first would log the
# credential outright, and the second carries ?config=<base64> on the
# Smithery path, which wraps one.
log_format mcp '$remote_addr "$request_method $uri" $status '
               '$body_bytes_sent client=$mcp_client rt=$request_time';

# ---------------------------------------------------------------------
# Port 80: ACME challenge + redirect
# ---------------------------------------------------------------------
server {
    listen 80 default_server;
    server_name ${DOMAIN};
    access_log /dev/stdout mcp;
    server_tokens off;

    # This has to stay reachable on plain HTTP permanently, not just at
    # issuance: certbot renews through the same webroot every 12 hours.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # ${HTTPS_PORT_SUFFIX} is "" for the default 443 and ":8443" for a
    # custom HTTPS_PORT. Without it, a stack published on non-default
    # ports would redirect to a port nothing is listening on.
    location / {
        return 301 https://$host${HTTPS_PORT_SUFFIX}$request_uri;
    }
}

# ---------------------------------------------------------------------
# Port 443: the actual server
# ---------------------------------------------------------------------
server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${DOMAIN};
    access_log /dev/stdout mcp;
    server_tokens off;
    default_type application/json;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    # No ssl_stapling: Let's Encrypt retired its OCSP responders in 2025,
    # so stapling has nothing to staple.

    add_header Strict-Transport-Security "max-age=31536000" always;

    # Tool inputs are prose, sometimes whole documents. The 1m default
    # is tight; 4m still bounds what reaches the Python process.
    client_max_body_size  4m;
    # Slow-client attacks terminate here rather than occupying a uvicorn
    # worker.
    client_header_timeout 10s;
    client_body_timeout   30s;
    send_timeout          30s;

    # Docker's embedded DNS, with the upstream held in a variable so the
    # name is resolved per request instead of at config load. Without
    # this, nginx refuses to start whenever the app container happens to
    # be down - which would also take the ACME challenge on port 80 with
    # it, and certificates would silently stop renewing. The cost is
    # losing upstream keepalive, which is immaterial at this traffic
    # level.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $upstream_app "app:8081";

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # The client's credential stops at nginx. The app only ever sees the
    # internal one, so a user token cannot end up in a Python traceback
    # or a rate-limit bucket key.
    proxy_set_header Authorization "Bearer ${INTERNAL_TOKEN}";

    # -----------------------------------------------------------------
    # The MCP endpoint: the only authenticated path
    # -----------------------------------------------------------------
    location /mcp {
        limit_req zone=per_ip burst=60 nodelay;

        # Streamable HTTP uses POST for calls, GET for the SSE stream,
        # and DELETE to end a session.
        if ($request_method !~ ^(GET|POST|DELETE|OPTIONS)$) {
            return 405 '{"error":"method_not_allowed"}';
        }

        if ($mcp_client = "") {
            # resource_metadata is the OAuth discovery hook (RFC 9728).
            # A client that cannot send a static bearer token reads it
            # from here and starts the discovery sequence documented in
            # the OAuth facade section below. Clients that do send a
            # static token never look at it.
            add_header WWW-Authenticate 'Bearer realm="estonian-mcp", resource_metadata="https://${DOMAIN}${HTTPS_PORT_SUFFIX}/.well-known/oauth-protected-resource"' always;
            # add_header does not merge across levels either: naming one
            # here drops the server-level HSTS, and an unauthenticated
            # probe is often a client's very first request.
            add_header Strict-Transport-Security "max-age=31536000" always;
            return 401 '{"error":"unauthorized"}';
        }

        limit_req  zone=per_client burst=60 nodelay;
        limit_conn conn_client 8;

        proxy_pass http://$upstream_app$request_uri;

        # proxy_set_header does not merge across levels: naming even one
        # here discards every inherited header, so the server-level set
        # is repeated in full before adding X-MCP-Client.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization     "Bearer ${INTERNAL_TOKEN}";
        # Lets the app attribute traffic without handling secrets.
        proxy_set_header X-MCP-Client      $mcp_client;

        # A GET /mcp can hold an SSE stream open indefinitely; buffering
        # it would defeat the point.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # -----------------------------------------------------------------
    # OAuth facade
    # -----------------------------------------------------------------
    # Claude's connector cannot send a static Authorization header, so it
    # runs OAuth discovery instead. This is a facade over the tokens that
    # already exist: the token endpoint hands back a value from
    # tokens.map, and /mcp above keeps validating it unchanged.
    #
    # Discovery sequence observed from a real connection attempt, in this
    # order. Note the path-suffixed variant is tried FIRST:
    #
    #   POST /mcp                                        401
    #   GET  /.well-known/oauth-protected-resource/mcp
    #   GET  /.well-known/oauth-protected-resource
    #   GET  /.well-known/oauth-authorization-server
    #   POST /register                                   <- DCR attempt
    #
    # /register is deliberately NOT implemented. Dynamic Client
    # Registration would have to hand a client secret to anyone who
    # asks, and that secret is the only thing protecting the token
    # endpoint here. Metadata that omits registration_endpoint tells a
    # conforming client that DCR is unavailable, so it falls back to the
    # client id and secret entered by hand in the connector's Advanced
    # settings. An unimplemented /register therefore answers 404 from
    # the catch-all at the bottom of this file, which is correct.

    # Both variants in one block: the client probes ".../mcp" first and
    # the bare path second.
    location ~ ^/\.well-known/oauth-protected-resource(?:/mcp)?$ {
        limit_req zone=per_ip burst=20 nodelay;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "public, max-age=3600" always;
        return 200 '{"resource":"https://${DOMAIN}${HTTPS_PORT_SUFFIX}/mcp","authorization_servers":["https://${DOMAIN}${HTTPS_PORT_SUFFIX}"],"bearer_methods_supported":["header"],"scopes_supported":["mcp"]}';
    }

    location ~ ^/\.well-known/oauth-authorization-server(?:/mcp)?$ {
        limit_req zone=per_ip burst=20 nodelay;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "public, max-age=3600" always;
        # No registration_endpoint: see above.
        #
        # token_endpoint_auth_methods_supported deliberately lists ONLY
        # client_secret_basic. nginx cannot read a request body, so a
        # client that sent its secret as a form field could not be
        # authenticated at all. Advertising one method steers the client
        # to the Authorization header, which auth_basic can check.
        #
        # Both grants are advertised because the token endpoint below is
        # grant-blind: it cannot see grant_type either way, so it answers
        # the same for both. Whichever the connector picks, it works.
        return 200 '{"issuer":"https://${DOMAIN}${HTTPS_PORT_SUFFIX}","authorization_endpoint":"https://${DOMAIN}${HTTPS_PORT_SUFFIX}/oauth/authorize","token_endpoint":"https://${DOMAIN}${HTTPS_PORT_SUFFIX}/oauth/token","response_types_supported":["code"],"grant_types_supported":["authorization_code","client_credentials"],"code_challenge_methods_supported":["S256"],"token_endpoint_auth_methods_supported":["client_secret_basic"],"scopes_supported":["mcp"]}';
    }

    # Browser redirect. Returns a fixed code that the token endpoint does
    # not check, so this endpoint grants nothing on its own: without the
    # client secret the code cannot be exchanged. Hence no login here.
    #
    # If you ever want a human login on this step, adding auth_basic to
    # this location alone will NOT work, for the phase-order reason
    # described on /oauth/token below: the `return 302` fires before
    # authentication runs. The redirect would have to move behind a
    # proxy_pass the same way the token body did.
    location = /oauth/authorize {
        limit_req zone=per_ip burst=20 nodelay;

        if ($oauth_redirect = "") {
            return 400 '{"error":"invalid_request","error_description":"redirect_uri is not in the allowlist"}';
        }
        # $arg_state is deliberately passed back still percent-encoded:
        # it goes straight into a query string, so re-encoding it would
        # corrupt it.
        return 302 "$oauth_redirect?code=${OAUTH_CODE}&state=$arg_state";
    }

    # The only endpoint that matters. auth_basic here IS the OAuth client
    # authentication: client_secret_basic sends exactly an HTTP Basic
    # header of client_id:client_secret, so nginx validates the client
    # secret with no scripting. Everything this facade protects, it
    # protects here.
    #
    # DO NOT answer this location with `return`. nginx runs `return` in
    # the REWRITE phase, which is BEFORE the ACCESS phase that auth_basic
    # belongs to, so the response goes out before authentication ever
    # runs and the access token reaches unauthenticated callers.
    #
    # proxy_pass is a CONTENT phase handler, which runs after access. So
    # the body comes from the loopback-only server at the bottom of this
    # file, and auth_basic is genuinely in front of it.
    location = /oauth/token {
        limit_req zone=per_ip burst=20 nodelay;

        # Preflight must stay unauthenticated: browsers never send
        # credentials on OPTIONS. This `return` runs in the rewrite phase
        # before auth_basic, which is correct here and only here.
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin  "*" always;
            add_header Access-Control-Allow-Headers "authorization,content-type" always;
            add_header Access-Control-Allow-Methods "POST,OPTIONS" always;
            return 204;
        }

        auth_basic "estonian-mcp oauth client";
        auth_basic_user_file /etc/nginx/secrets/oauth_clients.htpasswd;

        proxy_pass http://127.0.0.1:8091/token;
        # $remote_user is the client id auth_basic just verified. It
        # selects which access token the responder returns.
        proxy_set_header X-Oauth-Client $remote_user;
        # Naming any proxy_set_header here discards the inherited set,
        # including the server-level Authorization override. Clear it
        # explicitly so the client's Basic credentials are not forwarded.
        proxy_set_header Authorization "";
    }

    # -----------------------------------------------------------------
    # Public, unauthenticated paths served by the app: /health,
    # /metrics, the landing page, favicons, and the MCP server card.
    # These are public by design (see server.py), so nginx only
    # rate-limits them.
    # -----------------------------------------------------------------
    # They inherit the server-level proxy_set_header block above, so the
    # app sees the internal token on these too and stays in bearer mode.
    location = /                                 { limit_req zone=per_ip burst=60 nodelay; proxy_pass http://$upstream_app$request_uri; }
    location = /health                           { limit_req zone=per_ip burst=60 nodelay; proxy_pass http://$upstream_app$request_uri; }
    location = /metrics                          { limit_req zone=per_ip burst=60 nodelay; proxy_pass http://$upstream_app$request_uri; }
    location = /favicon.ico                      { limit_req zone=per_ip burst=60 nodelay; proxy_pass http://$upstream_app$request_uri; }
    location = /favicon.png                      { limit_req zone=per_ip burst=60 nodelay; proxy_pass http://$upstream_app$request_uri; }
    location = /favicon.svg                      { limit_req zone=per_ip burst=60 nodelay; proxy_pass http://$upstream_app$request_uri; }
    location = /.well-known/mcp/server-card.json { limit_req zone=per_ip burst=60 nodelay; proxy_pass http://$upstream_app$request_uri; }

    # Anything else never reaches Python.
    location / {
        return 404 '{"error":"not_found"}';
    }
}

# ---------------------------------------------------------------------
# Loopback-only token responder
# ---------------------------------------------------------------------
# Bound to 127.0.0.1 inside the container, so nothing outside it can
# reach this. It exists for one reason: /oauth/token has to answer from
# the content phase for auth_basic to run first. See the long comment on
# that location above.
server {
    listen 127.0.0.1:8091;
    access_log off;
    default_type application/json;

    location = /token {
        # RFC 6749 requires no-store on token responses.
        add_header Cache-Control "no-store" always;
        add_header Pragma "no-cache" always;
        add_header Access-Control-Allow-Origin "*" always;

        # The client authenticated but has no token in oauth_tokens.map.
        # Fail loudly rather than issuing an empty access_token, which
        # would fail later at /mcp with a confusing 401.
        if ($oauth_access_token = "") {
            return 500 '{"error":"server_error","error_description":"no access token is mapped for this client"}';
        }

        # expires_in is a year on purpose. A short lifetime would make
        # the client try to refresh, and there is no refresh endpoint.
        return 200 '{"access_token":"$oauth_access_token","token_type":"Bearer","expires_in":31536000,"scope":"mcp"}';
    }

    location / { return 404 '{"error":"not_found"}'; }
}
